    {
      "key": "facade_1",
      "type": "section",
      "label": {
        "en": "Facade 1",
        "fr": "Façade 1",
        "de": "Fassade 1",
        "es": "Fachada 1"
      },
      "description": {
        "en": "Leave the orientation empty to ignore a facade. Orientation: degrees from the north, clockwise (90 = east, 180 = south, 270 = west), or N, NE, E, SE, S, SW, W, NW.",
        "fr": "Laissez l'orientation vide pour ignorer une façade. Orientation : degrés depuis le nord, sens horaire (90 = est, 180 = sud, 270 = ouest), ou N, NE, E, SE, S, SO, O, NO.",
        "de": "Lass die Ausrichtung leer, um eine Fassade zu ignorieren. Ausrichtung: Grad ab Norden im Uhrzeigersinn (90 = Ost, 180 = Süd, 270 = West) oder N, NE, E, SE, S, SW, W, NW.",
        "es": "Deje la orientación vacía para ignorar una fachada. Orientación: grados desde el norte, en sentido horario (90 = este, 180 = sur, 270 = oeste), o N, NE, E, SE, S, SO, O, NO."
      }
    },
    {
      "key": "facade_1_orientation",
      "type": "string",
      "label": {
        "en": "Orientation",
        "fr": "Orientation",
        "de": "Ausrichtung",
        "es": "Orientación"
      },
      "placeholder": {
        "en": "e.g. 180 or S",
        "fr": "ex. 180 ou S",
        "de": "z. B. 180 oder S",
        "es": "p. ej. 180 o S"
      },
      "required": false,
      "default": "S"
    },
    {
      "key": "facade_1_name",
      "type": "string",
      "label": {
        "en": "Name (optional)",
        "fr": "Nom (facultatif)",
        "de": "Name (optional)",
        "es": "Nombre (opcional)"
      },
      "placeholder": {
        "en": "e.g. Living room",
        "fr": "ex. Salon",
        "de": "z. B. Wohnzimmer",
        "es": "p. ej. Salón"
      },
      "required": false
    },
    {
      "key": "facade_1_aperture",
      "type": "number",
      "label": {
        "en": "Field of view (°)",
        "fr": "Champ de vue (°)",
        "de": "Sichtfeld (°)",
        "es": "Campo de visión (°)"
      },
      "description": {
        "en": "Width of sky seen by the windows: 180 for a flat wall, less for deep window recesses or side walls.",
        "fr": "Largeur de ciel vue par les fenêtres : 180 pour un mur plat, moins pour des embrasures profondes ou des murs en retour.",
        "de": "Breite des Himmels, den die Fenster sehen: 180 für eine flache Wand, weniger bei tiefen Fensterlaibungen oder Seitenwänden.",
        "es": "Anchura de cielo vista por las ventanas: 180 para un muro plano, menos para huecos profundos o muros laterales."
      },
      "required": false,
      "default": 180,
      "min": 10,
      "max": 180
    },
    {
      "key": "facade_1_horizon",
      "type": "number",
      "label": {
        "en": "Horizon mask (°)",
        "fr": "Masque d'horizon (°)",
        "de": "Horizontmaske (°)",
        "es": "Máscara de horizonte (°)"
      },
      "description": {
        "en": "Sun elevation hidden by a hill, a building or a balcony in front of this facade, 0 if clear.",
        "fr": "Élévation du soleil cachée par une colline, un immeuble ou un balcon devant cette façade, 0 si dégagé.",
        "de": "Sonnenhöhe, die ein Hügel, ein Gebäude oder ein Balkon vor dieser Fassade verdeckt, 0 wenn frei.",
        "es": "Elevación del sol oculta por una colina, un edificio o un balcón frente a esta fachada, 0 si está despejado."
