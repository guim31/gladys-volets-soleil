  "type": "device",
  "name": "Volets & Soleil",
  "description": {
    "en": "Advised shutter closure per facade, from the sun position. Local, no account.",
    "fr": "Fermeture conseillée des volets par façade, d'après la position du soleil. Local, sans compte.",
    "de": "Empfohlene Rollladenschließung pro Fassade nach dem Sonnenstand. Lokal, ohne Konto.",
    "es": "Cierre aconsejado de las persianas por fachada según la posición del sol. Local, sin cuenta."
  },
  "version": "1.0.0",
  "docker_image": "ghcr.io/guim31/gladys-volets-soleil:1.0.0",
  "gladys_version": ">=5.1.0",
  "cover_image": "https://raw.githubusercontent.com/guim31/gladys-volets-soleil/main/cover.png",
  "categories": ["climate", "environment"],
  "transports": ["local"],
  "location": true,
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "How it works",
        "fr": "Fonctionnement",
        "de": "So funktioniert es",
        "es": "Funcionamiento"
      },
      "description": {
        "en": "The sun position is computed locally from the location of your house in Gladys. Describe each facade below: one device per facade, with the advised shutter closure.",
        "fr": "La position du soleil est calculée localement d'après la position de votre maison dans Gladys. Décrivez chaque façade ci-dessous : un appareil par façade, avec la fermeture conseillée des volets.",
        "de": "Der Sonnenstand wird lokal aus dem Standort deines Hauses in Gladys berechnet. Beschreibe unten jede Fassade: ein Gerät pro Fassade, mit der empfohlenen Schließung der Rollläden.",
        "es": "La posición del sol se calcula localmente a partir de la ubicación de su casa en Gladys. Describa cada fachada a continuación: un dispositivo por fachada, con el cierre aconsejado de las persianas."
      }
    },
